{
  "schemaVersion": 1,
  "id": "aztecaddon",
  "version": "${version}",
  "name": "AztecAddon",
  "description": "Tu segundo cerebro en anarchy. Memoria, seguridad pasiva y utilidades para servidores como 2b2t y 9b9t.",
  "authors": [
    "Desaparecido, AztecDev"
  ],
  "contact": {
    "sources": "https://github.com/TuUsuario/AztecAddon"
  },
  "icon": "assets/aztecaddon/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.aztec.addon.AddonTemplate"
    ]
  },
  "mixins": [
    "aztecaddon.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "0,168,107"
  },
  "depends": {
    "java": ">=21",
    "minecraft": [
      "1.21.11"
    ],
    "meteor-client": "*"
  }
}
